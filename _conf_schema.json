{
  "host": {
    "description": "监听地址",
    "type": "string",
    "default": "0.0.0.0"
  },
  "port": {
    "description": "监听端口",
    "type": "int",
    "default": 16199,
    "hint": "被占用时会自动往后找空闲端口，以日志实际端口为准"
  },
  "public_base_url": {
    "description": "对外展示地址",
    "type": "string",
    "default": "",
    "hint": "可选，例如 http://1.2.3.4:6199"
  },
  "webhooks": {
    "description": "Webhook 记录",
    "type": "template_list",
    "default": [],
    "hint": "由 /webhook add 生成，token 由服务端生成后用 /webhook set 填入",
    "templates": {
      "hook": {
        "name": "Webhook",
        "display_item": "name",
        "items": {
          "name": {
            "description": "名称",
            "type": "string",
            "default": ""
          },
          "session": {
            "description": "绑定的会话",
            "type": "string",
            "default": ""
          },
          "token": {
            "description": "服务端生成的令牌",
            "type": "string",
            "default": ""
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          }
        }
      }
    }
  },
  "events": {
    "description": "启用的 Webhook 事件",
    "type": "object",
    "items": {
      "approved_post": {
        "description": "新帖已审核 /webhook/approved-post",
        "type": "bool",
        "default": false
      },
      "approved_comment": {
        "description": "新评论已审核 /webhook/approved-comment",
        "type": "bool",
        "default": false
      },
      "pending_post": {
        "description": "新帖待审核 /webhook/pending-post",
        "type": "bool",
        "default": false
      },
      "pending_comment": {
        "description": "新评论待审核 /webhook/pending-comment",
        "type": "bool",
        "default": false
      }
    }
  }
}