{
  "host": {"description": "监听地址", "type": "string", "default": "0.0.0.0"},
  "port": {
    "description": "监听端口",
    "type": "int",
    "default": 6199,
    "hint": "服务端「Koishi 地址」填 http://你的IP:这个端口"
  },
  "public_base_url": {
    "description": "对外展示地址",
    "type": "string",
    "default": "",
    "hint": "可选，例如 http://1.2.3.4:6199"
  },
  "webhooks": {
    "description": "Webhook 记录",
    "type": "template_list",
    "default": [],
    "hint": "由 /webhook add 生成，token 由服务端生成后用 /webhook set 填入",
    "templates": {
      "hook": {
        "name": "Webhook",
        "display_item": "name",
        "items": {
          "name": {"description": "名称", "type": "string", "default": ""},
          "session": {"description": "绑定的会话", "type": "string", "default": ""},
          "token": {"description": "服务端生成的令牌", "type": "string", "default": ""},
          "enabled": {"description": "启用", "type": "bool", "default": true}
        }
      }
    }
  }
}
